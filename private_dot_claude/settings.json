{
  "cleanupPeriodDays": 3650,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/claude-stop.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/lunar-pr-gate.sh",
            "timeout": 120,
            "statusMessage": "lunar PR gate"
          },
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/jj-local-main-jail.sh",
            "timeout": 30,
            "statusMessage": "jj local/main jail"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/claude-attn.sh set"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/claude-stop.sh"
          },
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/claude-attn.sh clear"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/claude-stop.sh"
          },
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/claude-attn.sh set"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/claude-attn.sh clear"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/lunar-mix-format.sh",
            "timeout": 60,
            "statusMessage": "mix format (lunar)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ijcd/.claude/hooks/claude-attn.sh clear"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/ijcd/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "sentry@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "/private/tmp/claude-501/",

        "~/.gitconfig",
        "~/.config/git/config",
        "~/.config/git/ignore",
        "~/.config/git/attributes",
        "~/.config/git/git-machine",
        "~/.config/git/git-work-lunar",
        "~/.config/git/git-ijcd",

        "~/.config/jj/config.toml",
        "~/.config/jj/conf.d/**",
        "~/.config/jj/repos/**",
        "~/.config/jj/workspaces/**"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.gnupg/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)"
    ]
  },
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
