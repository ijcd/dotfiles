# jj (Jujutsu) config — managed by chezmoi (source: dot_config/jj/config.toml.tmpl).
#
# Per-host, mirroring ~/.config/git/config + git-machine: user.name global,
# user.email chosen per-tree via jj scoped config ([[--scope]]). FAIL-LOUD like
# git's useConfigOnly — NO default email; outside the trees below jj warns until
# a scope matches or you run:
#   jj config set --repo user.email you@example.com   (--repo, NOT --user)
#
# Paths are prefix-matched and `~` expands to $HOME (per jj docs).

[user]
name = "Ian Duggan"

{{ if eq .chezmoi.hostname "blackbird" -}}
# blackbird (work laptop): ALL of ~/work -> golunar; personal in ~/src/ijcd + chezmoi.
[[--scope]]
--when.repositories = ["~/work"]
[--scope.user]
email = "ian@golunar.com"

[[--scope]]
--when.repositories = ["~/src/ijcd", "~/.local/share/chezmoi"]
[--scope.user]
email = "ian@ianduggan.net"
{{- else -}}
# home / other machines (e.g. bearcat): Lunar only under ~/work/lunar -> golunar;
# ~/src and chezmoi personal. (~/work non-lunar stays fail-loud here.)
[[--scope]]
--when.repositories = ["~/work/lunar"]
[--scope.user]
email = "ian@golunar.com"

[[--scope]]
--when.repositories = ["~/src", "~/.local/share/chezmoi"]
[--scope.user]
email = "ian@ianduggan.net"
{{- end }}

# Workflow aliases (host-independent), PER-WORKSPACE-BASE aware. Each agent works
# off its own base local/main-<workspace> (jj-flow), so these no longer hardcode a
# shared local/main — that shared base was the source of cross-agent conflicts.
[revset-aliases]
# mine = my wip branches ON THIS WORKSPACE'S base (wip/* descending from the nearest
# local/main-* ancestor of @). Base-agnostic — no shared-base reference.
'mine' = 'bookmarks(regex:"^wip/") & descendants(heads(::@ & bookmarks(regex:"^local/main")))'
# sincemain = my work since MY base: the nearest local/main-* bookmark at-or-behind
# @ (= this workspace's base) .. @. Per-workspace by construction.
'sincemain' = 'heads(::@ & bookmarks(regex:"^local/main"))..@'
'sincemaster' = 'trunk()..@'
# closest_bookmark(to) = the nearest bookmark at-or-behind `to` (used by `jj tug`).
'closest_bookmark(to)' = 'heads(::to & bookmarks())'

[aliases]
# restack / restack-mine REMOVED: jj-flow catchup does the per-workspace rebase now
# (roots(trunk()..local/main-<W>) → trunk()), and the old aliases hardcoded the
# shared local/main base, which dragged every other agent. Use `jjf catchup`.
# tug: advance the nearest bookmark up to @- (across all workspaces with --all).
# Runs jj-flow's tug (the standalone jj-tug shim was retired).
tug = ["util", "exec", "--", "jj-flow", "tug"]
# rp/lp: patch logs. rp = work since my base with --stat; lp = plain -p.
rp = ["log", "--no-graph", "-r", "sincemain", "--stat", "-p"]
lp = ["log", "--no-graph", "-p"]
# vine: run jj-vine (stacked-PR submit helper) as `jj vine …`.
vine = ["util", "exec", "--", "jj-vine"]

[ui]
diff-formatter = ":git" # jj's own git-style diff
pager = "delta"
