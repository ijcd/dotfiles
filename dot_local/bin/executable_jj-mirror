#!/usr/bin/env bash
# jj-mirror — compat entry point. The logic lives in jjflow-mirror.sh, shared with
# jj-flow (`jj-flow mirror` / `jj-flow push`). Kept as a thin entry so the fleet
# and the test suite that call `jj-mirror …` directly keep working.
set -euo pipefail
if (( BASH_VERSINFO[0] < 4 )); then
  echo "jj-mirror: bash ${BASH_VERSION} too old — needs bash 4+" >&2; exit 1
fi
source "$(dirname "$0")/jjflow-mirror.sh"
mirror_main "$@"
