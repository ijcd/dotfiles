#!/usr/bin/env bash
# runclaude — launch Claude in cwd, set kitty tab title to cc:<name>.
#
# Auto-detects whether a previous session exists in this directory; uses
# --continue only when there's something to continue, fresh start otherwise.
# That way `claude --continue` never errors out on "no session to continue."
#
# Usage:
#   runclaude            # name = basename of cwd
#   runclaude <name>     # explicit tab name
#
# A script rather than a shell function so session managers (sesh, etc.)
# that enumerate executables on PATH can find it.

set -uo pipefail

name="${1:-$(basename "$PWD")}"

# Kitty tab title — silent on non-kitty terminals.
if [ -n "${KITTY_LISTEN_ON:-}" ]; then
    kitty @ set-tab-title "cc:${name}" 2>/dev/null || true
fi

# tmux window name — disable automatic-rename so it sticks past claude startup.
if [ -n "${TMUX:-}" ]; then
    tmux set-window-option automatic-rename off 2>/dev/null || true
    tmux rename-window "cc:${name}" 2>/dev/null || true
fi

# Claude Code's session storage: ~/.claude/projects/<encoded-cwd>/*.jsonl
# where encoded-cwd is $PWD with '/', '.', and '_' replaced by '-'.
# e.g. /Users/foo/.bar/baz_qux → -Users-foo--bar-baz-qux
encoded="$(echo "$PWD" | sed 's|[/._]|-|g')"
project_dir="$HOME/.claude/projects/$encoded"

# Decide --continue vs fresh based on whether any session jsonl exists.
shopt -s nullglob
sessions=("$project_dir"/*.jsonl)

# Name the auto-started Remote Control session (the one you see on the phone).
# RC is enabled via settings.json (remoteControlAtStartup=true); its name is a
# SEPARATE namespace from --name (defaults to <hostname>-<random>), so the
# explicit name arg on --remote-control is the only lever. Format is
# "<prefix>-<name>": the prefix disambiguates the machine on the phone (which is
# why RC's own default is the hostname). Default = short hostname; blackbird is
# the lunar work laptop, so give it a semantic label. Override with CLAUDE_RC_PREFIX.
if [ -n "${CLAUDE_RC_PREFIX:-}" ]; then
    rc_prefix="$CLAUDE_RC_PREFIX"
else
    case "$(hostname -s)" in
        blackbird) rc_prefix="lunar/ijcd" ;;
        *)         rc_prefix="$(hostname -s)" ;;
    esac
fi
rc=(--remote-control "${rc_prefix}-${name}")

if [ "${#sessions[@]}" -gt 0 ]; then
    exec claude --dangerously-skip-permissions "${rc[@]}" --continue
else
    exec claude --dangerously-skip-permissions "${rc[@]}"
fi
