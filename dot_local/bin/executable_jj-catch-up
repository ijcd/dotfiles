#!/usr/bin/env bash
# jj-catch-up — compat entry. Logic in jjflow-catchup.sh (shared with `jj-flow
# catchup`). Rebase parameterized by [jj-flow] base; conflicts roll back.
set -uo pipefail
if (( BASH_VERSINFO[0] < 4 )); then
  echo "jj-catch-up: bash ${BASH_VERSION} too old — needs bash 4+" >&2; exit 1
fi
source "$(dirname "$0")/jjflow-lib.sh"
source "$(dirname "$0")/jjflow-refresh.sh"
source "$(dirname "$0")/jjflow-catchup.sh"
catchup_main "$@"
